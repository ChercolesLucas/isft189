<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers><add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" /></handlers>
      <aspNetCore processPath="dotnet" arguments=".\IngSoft.Api.dll" hostingModel="inprocess" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Routing__StripApiPrefixWhenHostedUnderApi" value="true" />
          <environmentVariable name="InternalLogging__Directory" value="C:\WebApps\Seminario\Logs" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
